<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_editor">

        <ListPreference
            app:defaultValue="dark"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="editor_theme"
            app:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="14"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="editor_font_size"
            app:title="@string/pref_font_size"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="4"
            app:entries="@array/tab_size_entries"
            app:entryValues="@array/tab_size_values"
            app:key="editor_tab_size"
            app:title="@string/pref_tab_size"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="editor_line_numbers"
            app:title="@string/pref_line_numbers" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="editor_word_wrap"
            app:title="@string/pref_word_wrap" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="editor_auto_indent"
            app:title="@string/pref_auto_indent" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="editor_auto_close_brackets"
            app:title="@string/pref_auto_close" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="editor_auto_save"
            app:title="@string/pref_auto_save" />
    </PreferenceCategory>
</PreferenceScreen>
